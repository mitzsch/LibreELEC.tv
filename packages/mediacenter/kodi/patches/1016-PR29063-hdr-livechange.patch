+CDRMPropertyBlob& CWinSystemGbm::PushHDRBlob(int fd, const void* data, std::size_t size)
+{
+  m_hdrBlobs.emplace_back(fd, data, size);
+  while (m_hdrBlobs.size() > 2)
+    m_hdrBlobs.pop_front();
+
+  return m_hdrBlobs.back();
+}
